#====================
# Oh My Zsh Configuration
#====================
export ZSH=$HOME/.oh-my-zsh
ZSH_THEME=""
HIST_STAMPS="yyyy-mm-dd"

# Core plugins
plugins=(
  zsh-syntax-highlighting
  zsh-autosuggestions
  macos
  pip
  brew
  git
  docker
  jira
  pylint
  rand-quote
  sublime
  web-search
  zsh-vim-mode
)
source $ZSH/oh-my-zsh.sh

#====================
# Path & Environment Variables
#====================
# Apple Silicon vs Intel installs Homebrew to different prefixes - shellenv
# figures out the right PATH/MANPATH/etc for whichever this Mac is.
if [ -d /opt/homebrew/bin ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"   # Apple Silicon
elif [ -d /usr/local/Homebrew ]; then
    eval "$(/usr/local/bin/brew shellenv)"      # Intel
fi

# /opt/nvim was the Linux AppImage location for Neovim - it now comes from
# Homebrew (already on PATH via shellenv above). /home/linuxbrew doesn't
# exist on macOS. Both dropped.
export PATH="$PATH:$HOME/bin:$HOME/.local/bin"

# zsh doesn't understand HISTCONTROL (that's a bash-ism) - this was a silent
# no-op on Linux too, not a macOS-specific fix. Real zsh equivalents:
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS

export EDITOR=nvim

#====================
# Source Files & Secrets
#====================
# Load aliases
source "$HOME/.dotfiles/system/.alias"
echo "Loaded non-secrets."

# Load secret files
# SECRETS="$HOME/.dotfiles/secrets"
# for file in "$SECRETS"/.*
# do
#   source "$file"
#   echo "Loaded $file"
# done
# echo "Loaded secrets."
#
#====================
# Tool Configurations
#====================
# Zoxide - smarter cd command
eval "$(zoxide init zsh)"

# NVM (Node Version Manager)
export NVM_DIR="$([ -z "${XDG_CONFIG_HOME-}" ] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"


#====================
# Prompt Configuration
#====================
# Pure prompt setup
fpath+=($HOME/.zsh/pure)
autoload -U promptinit && promptinit
autoload -U compinit && compinit
prompt pure

# Pure prompt colors (currently commented out)
# These use purple/violet shades:
# zstyle :prompt:pure:path color "#af87d7"        # Light purple for directory path
# zstyle :prompt:pure:prompt:success color "#af87d7"  # Light purple for success indicator

#====================
# Additional Tools & Completions
#====================
# Envman configuration
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"

# Nix package manager - only does anything if you've actually installed Nix
# on this Mac, harmless no-op otherwise. Was hardcoded to /home/angelaambroz
# before; now checks the per-user profile path generically, plus the
# system-wide path some macOS Nix installers use.
if [ -e "$HOME/.nix-profile/etc/profile.d/nix.sh" ]; then
    . "$HOME/.nix-profile/etc/profile.d/nix.sh"
elif [ -e '/etc/profile.d/nix.sh' ]; then
    . '/etc/profile.d/nix.sh'
fi

# Clyde completion
_clyde() {
  eval $(env COMMANDLINE="${words[1,$CURRENT]}" _CLYDE_COMPLETE=complete-zsh  clyde)
}
if [[ "$(basename -- ${(%):-%x})" != "_clyde" ]]; then
  compdef _clyde clyde
fi

fpath+=${ZDOTDIR:-~}/.zsh_functions

#====================
# Application Configs
#====================
# Alacritty configuration setup
mkdir -p ~/.config/alacritty
if [ ! -f ~/.config/alacritty/alacritty.toml ]; then
    ln -s $HOME/.dotfiles/system/alacritty.toml ~/.config/alacritty/alacritty.toml
fi

# Google Cloud SDK - the official installer drops everything into
# $HOME/google-cloud-sdk on macOS too, so only the hardcoded username needed
# to go, not the path shape itself.
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# This used to point at a previous job's project directory
# (/home/angelaambroz/Documents/work/discord/.local/bin). Left out rather than
# guessed at - add whatever GetYourGuide's equivalent is, if there is one.
# export PATH="$HOME/Documents/work/<something>/.local/bin:$PATH"
